<h1>Dashboard Barang</h1>
<p class="sub">Pilih barang untuk mulai checkout dan mencoba payment gateway.</p>

<div class="grid">
  <% products.forEach(function (p) { %>
    <div class="card product">
      <% if (p.image) { %>
        <img src="<%= p.image %>" alt="<%= p.name %>">
      <% } %>
      <div class="body">
        <div class="name"><%= p.name %></div>
        <div class="desc"><%= p.description %></div>
        <div class="price">Rp <%= Number(p.price).toLocaleString('id-ID') %></div>
        <a class="btn" href="/checkout?product_id=<%= p.id %>">Beli</a>
      </div>
    </div>
  <% }); %>
</div>
