<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Payment Gateway Playground</title>
  <style>
    :root {
      --bg: #f4f6fb;
      --card: #ffffff;
      --ink: #1c2333;
      --muted: #66708a;
      --accent: #2f6bff;
      --accent-dark: #1f4fd0;
      --ok: #16a34a;
      --warn: #d97706;
      --err: #dc2626;
      --radius: 12px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--ink);
    }
    header.topbar {
      background: var(--card);
      border-bottom: 1px solid #e3e7f0;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    header.topbar a.brand {
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
      text-decoration: none;
    }
    header.topbar span.badge {
      font-size: 0.72rem;
      background: #eef3ff;
      color: var(--accent);
      border-radius: 999px;
      padding: 3px 10px;
      font-weight: 600;
    }
    main { max-width: 960px; margin: 32px auto; padding: 0 20px; }
    h1 { font-size: 1.5rem; margin: 0 0 4px; }
    p.sub { color: var(--muted); margin: 0 0 24px; }
    .card {
      background: var(--card);
      border: 1px solid #e3e7f0;
      border-radius: var(--radius);
      padding: 20px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 18px;
    }
    .product { display: flex; flex-direction: column; overflow: hidden; padding: 0; }
    .product img { width: 100%; height: 150px; object-fit: cover; display: block; }
    .product .body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .product .name { font-weight: 700; }
    .product .desc { color: var(--muted); font-size: 0.85rem; flex: 1; }
    .product .price { font-weight: 700; color: var(--accent-dark); }
    .btn {
      display: inline-block;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 10px 18px;
      font-size: 0.92rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      text-align: center;
    }
    .btn:hover { background: var(--accent-dark); }
    .btn.secondary { background: #eef1f8; color: var(--ink); }
    label { display: block; font-weight: 600; font-size: 0.85rem; margin: 14px 0 6px; }
    input[type="text"], input[type="email"], input[type="tel"], input[type="number"], select {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #cfd6e4;
      border-radius: 8px;
      font-size: 0.95rem;
      background: #fff;
    }
    .status { display: inline-block; padding: 4px 12px; border-radius: 999px; font-weight: 700; font-size: 0.8rem; }
    .status.PAID { background: #e7f7ec; color: var(--ok); }
    .status.PENDING { background: #fff4e5; color: var(--warn); }
    .status.FAILED, .status.EXPIRED { background: #fdeaea; color: var(--err); }
    footer { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 32px 0; }
  </style>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">🛍️ Payment Gateway Playground</a>
    <span class="badge">Pakasir · iPaymu · DOKU</span>
  </header>
  <main>
    <%- body %>
  </main>
  <footer>Proyek percobaan integrasi payment gateway Indonesia — lihat PRD.md & TASKLIST-*.md</footer>
</body>
</html>
