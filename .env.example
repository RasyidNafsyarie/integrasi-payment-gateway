# ==========================================================
# Template konfigurasi — salin menjadi `.env` lalu isi nilainya.
# JANGAN isi nilai asli di file ini (file ini ikut ter-commit).
# ==========================================================

# Server
PORT=3000
APP_URL=http://localhost:3000

# ---- PAKASIR (TASKLIST-PAKASIR.md) ----
# Mode: sandbox | production (dibedakan lewat mode Proyek di dashboard)
PAKASIR_MODE=sandbox
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com

# ---- iPAYMU (TASKLIST-IPAYMU.md) ----
# Mode: sandbox | production (base URL & kredensial berbeda per mode)
IPAYMU_MODE=sandbox
IPAYMU_BASE_URL=https://sandbox.ipaymu.com
IPAYMU_VA=
IPAYMU_API_KEY=

# ---- DOKU (TASKLIST-DOKU.md) ----
# Mode: sandbox | production (base URL & kredensial berbeda per mode)
DOKU_MODE=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
